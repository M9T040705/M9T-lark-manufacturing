# ===== 后端服务配置 =====
PORT=3000
NODE_ENV=development

# ===== 数据库（开发默认 SQLite，零依赖） =====
DATABASE_URL="file:./dev.db"
# 生产 MySQL 示例：
# DATABASE_URL="mysql://flybook:flybook123@mysql:3306/flybook?charset=utf8mb4"

# ===== JWT 认证 =====
JWT_SECRET="flybook-saas-dev-secret-change-me"
JWT_EXPIRES="2h"
JWT_REFRESH_EXPIRES="7d"

# ===== CORS =====
CORS_ORIGIN="http://localhost:5173"

# ===== 飞书自建应用（留空跳过飞书能力） =====
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
FEISHU_VERIFY_TOKEN=""
FEISHU_ENCRYPT_KEY=""

# ===== 大模型（可选，不配置则智能体降级为规则引擎） =====
# OpenAI 兼容接口（DeepSeek / 硅基流动 / 通义 / 火山方舟等）
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"
LLM_TIMEOUT=30

# ===== 向量化（可选，RAG 知识库用） =====
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_TIMEOUT=30

# ===== 文件上传 =====
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
