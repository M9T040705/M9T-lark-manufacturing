# ===== 生产部署环境变量模板 =====
# 用法：cp .env.production.example .env，填入真实值后执行  docker compose up -d --build
# .env 含敏感信息，切勿提交 Git 或外传。

# --- MySQL ---
MYSQL_DATABASE=flybook
MYSQL_USER=flybook
# 强密码生成： openssl rand -hex 16
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_PORT=3306

# --- 后端 ---
# JWT 密钥生成： openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
JWT_EXPIRES=7d
API_PORT=3000

# --- 前端 / 域名 ---
# 改成正式域名；同时在飞书开放平台「安全设置-重定向 URL」加入：
#   https://你的域名/feishu/callback
APP_DOMAIN=https://erp.example.com
CORS_ORIGIN=https://erp.example.com
WEB_PORT=8080
REDIS_PORT=6379

# 首次启动是否写入演示租户/演示数据：正式生产设 false
SEED_DEMO=false

# --- 大模型（DeepSeek，OpenAI 兼容接口）---
# 三项都填才启用大模型；任一留空则自动使用内置规则引擎（数据隔离不降级）
# API Key 申请：https://platform.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
